# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM providers
LLM_PROVIDER=groq                         # groq | anthropic
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Geoapify (routing — Task 010)
GEOAPIFY_API_KEY=

# Triage agent behaviour
TRIAGE_MAX_FOLLOWUPS=4        # hard ceiling on follow-up turns before forced classification
TRIAGE_MIN_TURNS=2            # minimum user turns before triage_response is honoured
TRIAGE_CONTEXT_WINDOW=10      # last N messages passed as context to LLM
TRIAGE_TOP_N_FACILITIES=3     # number of nearest candidates returned to frontend

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Frontend — Vite (VITE_ prefix required for browser exposure)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000
VITE_GEOAPIFY_API_KEY=

# OneSignal — frontend (player_id capture)
VITE_ONESIGNAL_APP_ID=

# Google Analytics 4 — frontend, loaded only after cookie-consent opt-in (Task 012)
VITE_GA_MEASUREMENT_ID=

# OneSignal — backend (send notifications via REST API)
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Observability — runtime context
ENVIRONMENT=staging

# Sentry — backend
SENTRY_DSN_BACKEND=
SENTRY_TRACES_SAMPLE_RATE=0.2

# Sentry — frontend (Vite requires VITE_ prefix)
VITE_SENTRY_DSN_FRONTEND=
VITE_SENTRY_ENVIRONMENT=staging

# SENTRY_DSN_FRONTEND stored in Doppler for reference; only VITE_SENTRY_DSN_FRONTEND is read by the browser bundle
SENTRY_DSN_FRONTEND=

# Grafana Cloud — metrics push (Prometheus remote write)
GRAFANA_PROMETHEUS_REMOTE_WRITE_URL=
GRAFANA_PROMETHEUS_INSTANCE_ID=
GRAFANA_API_TOKEN=

# Grafana Cloud — log forwarding handled by Railway log drains (no code needed)
# Kept here for reference / manual push fallback only
GRAFANA_LOKI_PUSH_URL=
GRAFANA_LOKI_INSTANCE_ID=

# Metrics endpoint protection
METRICS_BEARER_TOKEN=

# Evaluation — Sprint 17 Phase B (DeepEval faithfulness pass, eval project only)
EVAL_API_BASE_URL=                        # eval-project preview backend base URL, used by scripts/triage_deepeval
OPENAI_API_KEY=                           # DeepEval judge model (gpt-4o-mini) — eval project only, never prod

