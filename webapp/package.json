{
  "name": "reactclient",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "doppler-dev": "doppler setup --project medicoord --config dev_personal --no-interactive && doppler run -- vite --host",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/react": "^10.53.1",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.1.8",
    "leaflet": "^1.9.4",
    "motion": "^12.41.0",
    "react": "^19.0.0-rc.1",
    "react-dom": "^19.0.0-rc.1",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0-rc.2",
    "react-responsive-carousel": "^3.2.23",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.48.0",
    "@faker-js/faker": "^9.9.0",
    "@types/jsdom": "^28.0.3",
    "@types/leaflet": "^1.9.19",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.4",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^4.1.9"
  }
